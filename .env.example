DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
OTP_BACKEND=smsir
ENABLE_MOCK_OTP=false
MOCK_OTP_PREFIX=0950
MOCK_OTP_CODE=11111
# SMS.ir API key and the numeric ID of your approved verification template.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
# Exact OTP placeholder name in that template, without surrounding # characters.
# For example, use PARAMETER1 if the template contains #PARAMETER1#.
SMSIR_CODE_PARAMETER=CODE
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=
# Optional stable secret for encrypting personal keys; defaults to DJANGO_SECRET_KEY.
AI_SETTINGS_ENCRYPTION_SECRET=
OPENAI_MODEL=gpt-5.5
VITE_API_URL=/api/v1
ACCESS_AUDIT_PHONE_NUMBER=
ACCESS_AUDIT_TRUST_PROXY_IP=false
# One JSON event per line; defaults to backend/logs/access-audit.jsonl.
ACCESS_AUDIT_LOG_PATH=
# Optional absolute path to a locally mounted GeoLite2-City.mmdb file.
GEOIP_CITY_DB_PATH=/app/geoip/GeoLite2-City.mmdb
