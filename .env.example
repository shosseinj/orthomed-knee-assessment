DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
OTP_BACKEND=console
ENABLE_MOCK_OTP=true
MOCK_OTP_PREFIX=0950
MOCK_OTP_CODE=12345
